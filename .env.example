PORT=3000

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Token exigido para criar o primeiro admin. Gere da mesma forma que JWT_SECRET.
SETUP_TOKEN=

# Caminho do banco SQLite. Em produção, use um volume persistente.
# Exemplo com Docker: /data/desk-booking.db
DB_PATH=./data.db

# Domínio de origem permitida para CORS. Ex: https://desk.empresa.com
ALLOWED_ORIGIN=

# SMTP (opcional) — deixe em branco para desabilitar e-mails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
