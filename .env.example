PORT=3000

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Token exigido para criar o primeiro admin. Gere da mesma forma que JWT_SECRET.
SETUP_TOKEN=

# Caminho do banco SQLite. Em produção, use um volume persistente.
# Exemplo com Docker: /data/workplace.db
DB_PATH=./data.db

# Domínio de origem permitida para CORS. Ex: https://workplace.empresa.com
ALLOWED_ORIGIN=

# ─── SSO Azure Entra ID ───────────────────────────────────────────────────────
# Habilita o botão "Entrar com Microsoft" na tela de login
SSO_ENABLED=true

# App Registration Voxcred (multi-tenant — cobre também usuários Tenda convidados)
#   Redirect URI no Azure: https://SEU_DOMINIO/api/auth/sso/callback
ENTRA_VOXCRED_TENANT_ID=
ENTRA_VOXCRED_CLIENT_ID=
ENTRA_VOXCRED_CLIENT_SECRET=

# Tenant ID Tenda (opcional — preencher se Tenda tiver tenant Azure separado)
# ENTRA_TENDA_TENANT_ID=

# ─── E-mail (opcional) ────────────────────────────────────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@empresa.com
# SMTP_PASS=
# SMTP_FROM=noreply@empresa.com
