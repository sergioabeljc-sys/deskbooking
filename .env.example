PORT=3000

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Token exigido para criar o primeiro admin. Gere da mesma forma que JWT_SECRET.
SETUP_TOKEN=

# Caminho do banco SQLite. Em produção, use um volume persistente.
# Exemplo com Docker: /data/workplace.db
DB_PATH=./data.db

# Domínio de origem permitida para CORS. Ex: https://workplace.empresa.com
ALLOWED_ORIGIN=

# ─── SSO Azure Entra ID ───────────────────────────────────────────────────────
# App Registration único multi-tenant (botão SSO sem digitar e-mail):
#   1. Azure Portal → Entra ID → App registrations → New registration
#   2. Supported account types: "Accounts in any organizational directory"
#   3. Redirect URI: https://SEU_DOMINIO/api/auth/sso/callback
#   4. Certificates & secrets → New client secret
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Tenant IDs de cada empresa — usados para mapear o tid do token à empresa correta
ENTRA_VOXCRED_TENANT_ID=
ENTRA_TENDA_TENANT_ID=

# ─── E-mail (opcional) ────────────────────────────────────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@empresa.com
# SMTP_PASS=
# SMTP_FROM=noreply@empresa.com
