PORT=3000

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Token exigido para criar o primeiro admin. Gere da mesma forma que JWT_SECRET.
SETUP_TOKEN=

# Caminho do banco SQLite. Em produção, use um volume persistente.
# Exemplo com Docker: /data/workplace.db
DB_PATH=./data.db

# Domínio de origem permitida para CORS. Ex: https://workplace.empresa.com
ALLOWED_ORIGIN=

# ─── SSO Azure Entra ID ───────────────────────────────────────────────────────
# Para cada empresa, crie um App Registration no Azure Portal:
#   1. Azure Portal → Entra ID → App registrations → New registration
#   2. Redirect URI: https://SEU_DOMINIO/api/auth/sso/callback
#   3. Certificates & secrets → New client secret
#   4. Copie Application (client) ID, Directory (tenant) ID e o secret abaixo

# Tenant Voxcred
ENTRA_VOXCRED_CLIENT_ID=
ENTRA_VOXCRED_CLIENT_SECRET=
ENTRA_VOXCRED_TENANT_ID=

# Tenant Tenda
ENTRA_TENDA_CLIENT_ID=
ENTRA_TENDA_CLIENT_SECRET=
ENTRA_TENDA_TENANT_ID=

# ─── E-mail (opcional) ────────────────────────────────────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@empresa.com
# SMTP_PASS=
# SMTP_FROM=noreply@empresa.com
